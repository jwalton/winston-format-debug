{
    "name": "winston-format-debug",
    "version": "0.0.0-semantic-release",
    "description": "Debug formatter for Winston",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "test": "npm run build && npm run lint && npm run test:unittest",
        "build": "tsc",
        "clean": "rm -rf dist coverage",
        "test:unittest": "tsc -p test && NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "lint": "eslint",
        "prepare": "husky install && npm run build",
        "prepublishOnly": "npm run build && npm test",
        "semantic-release": "semantic-release"
    },
    "lint-staged": {
        "{test,src}/**/*.ts": [
            "prettier --write",
            "eslint"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jwalton/winston-format-debug.git"
    },
    "keywords": [
        "winston",
        "log",
        "debug",
        "pretty",
        "stream",
        "stdout",
        "error"
    ],
    "author": {
        "name": "Jason Walton",
        "email": "dev@lucid.thedreaming.org",
        "url": "https://github.com/jwalton"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/jwalton/winston-format-debug/issues"
    },
    "homepage": "https://github.com/jwalton/winston-format-debug#readme",
    "engines": {
        "node": ">=22.0.0"
    },
    "peerDependencies": {
        "winston": "3.*.*"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.5.2",
        "@jwalton/semantic-release-config": "^1.0.0",
        "@types/chai": "^5.2.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "chai": "^6.3.0",
        "chai-as-promised": "^8.0.2",
        "chai-jest": "^1.0.3",
        "eslint": "^10.13.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "semantic-release": "^25.0.9",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "winston": "^3.19.0"
    },
    "greenkeeper": {
        "ignore": [
            "@types/node"
        ]
    },
    "dependencies": {
        "chalk": "^6.0.1",
        "sementic-release": "^1.5.1",
        "triple-beam": "^1.4.1"
    }
}
